{
  "name": "nibblecue",
  "private": true,
  "description": "NibbleCue monorepo: the Expo app and its shared TypeScript packages. Read CLAUDE.md first.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "mobile": "pnpm --filter mobile exec expo start",
    "mobile:clear": "pnpm --filter mobile exec expo start -c",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck --force",
    "test": "turbo run test --concurrency=1 --force",
    "test:entitlements": "vitest run packages/core/src/plan",
    "test:brand": "vitest run packages/brand",
    "test:safety": "vitest run packages/core/src/nibble/planner packages/core/src/nibble/safety",
    "check:copy": "vitest run packages/core/src/nibble/copy.test.ts apps/mobile/src/screens/nibble/copy.test.ts",
    "check:expo-go": "node tools/expo-go-imports.mjs",
    "check:reuse": "node tools/reuse-check.mjs",
    "gate": "node tools/gate.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "typescript-eslint": "^8.70.0",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,yml,yaml,css}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
