{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.21.0",
      "pnpm": "10.33.0",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_ENV": "development" }
    },
    "preview": {
      "node": "24.21.0",
      "pnpm": "10.33.0",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_ENV": "staging", "EXPO_PUBLIC_AUTH_PROVIDER": "supabase" },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "production": {
      "node": "24.21.0",
      "pnpm": "10.33.0",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_AUTH_PROVIDER": "supabase",
        "EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED": "true",
        "EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED": "true"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "completed" }
    }
  }
}
