{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The NibbleCue app: Expo SDK 57, React Native, TypeScript strict. Built on CuddleCue's app shell (docs/REUSE.md).",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "config": "expo config --type public",
    "eas-build-pre-install": "node ./eas-pnpm.cjs",
    "test": "vitest run && vitest run --config vitest.smoke.config.mts"
  },
  "dependencies": {
    "@nibblecue/brand": "workspace:*",
    "@nibblecue/core": "workspace:*",
    "@nibblecue/db": "workspace:*",
    "@nibblecue/ui": "workspace:*",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/ui": "~57.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@supabase/supabase-js": "^2.116.0",
    "aes-js": "^3.1.2",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-print": "^57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "^57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-freeze": "1.0.4",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-purchases": "10.10.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "catalog:",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "happy-dom": "20.14.5",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
