+  /// The `size` prop arrives as a `font` modifier. A symbol uses that font; a raster ignores it,
+  /// so the template image is framed to the same number of points.
+  private static func templateSide(_ modifiers: ModifierArray?) -> CGFloat {
+    guard let modifiers else { return 24 }
+    for modifier in modifiers {
+      guard modifier["$type"] as? String == "font" else { continue }
+      if let size = modifier["size"] as? CGFloat { return size }
+      if let size = modifier["size"] as? Double { return CGFloat(size) }
+      if let size = modifier["size"] as? NSNumber { return CGFloat(truncating: size) }
+    }
+    return 24
+  }
+
   @ViewBuilder
   public var body: some View {
-    if let symbolImage {
+    // `assetName` is a raster in the widget extension's asset catalog, drawn as its catalog says:
+    // a line glyph is a template the foreground style tints, an illustrated picture keeps its
+    // own colors. `Image(name, variableValue:)` looks up a symbol set, which these are not.
+    if let assetName = props.assetName {
+      let side = Self.templateSide(props.modifiers)
+      Image(assetName)
+        .resizable()
+        .scaledToFit()
+        .frame(width: side, height: side)
+        .applyOnTapGesture(useTapGesture: props.useTapGesture, eventDispatcher: props.onTap)
+    } else if let symbolImage {
       symbolImage
         .applyImageModifiers(props.modifiers, appContext: props.appContext)
         .applyOnTapGesture(useTapGesture: props.useTapGesture, eventDispatcher: props.onTap)
