{
  "profile": "CDC_CHILD_US",
  "version": "2026_01",
  "source": "CDC Child and Adolescent Immunization Schedule, United States",
  "sourceUrl": "https://www.cdc.gov/vaccines/hcp/imz-schedules/child-adolescent-age.html",
  "effectiveDate": "2026-01-15",
  "coverage": "birth through 6 years (routine doses); later adolescent doses are out of scope for v1",
  "disclaimer": "This is the published routine schedule for record keeping, not advice about your child. Your pediatrician's plan always takes priority, and you can edit every date here.",
  "rules": [
    "Never tell a parent their child is behind, at risk, or needs a catch-up plan.",
    "Never compute or display a vaccine dose, volume or product choice.",
    "Windows are shown as published age ranges; status is descriptive only (given / due / upcoming / past published window).",
    "Every dose is editable, skippable and can be marked declined with a free-text reason recorded verbatim.",
    "Optional and seasonal immunisations are OFF until the household turns them on.",
    "Guidance lives in this versioned file only — never in code, never generated."
  ],
  "statusLabels": {
    "GIVEN": "Given",
    "DUE": "Due now",
    "UPCOMING": "Upcoming",
    "PAST_WINDOW": "Past published window",
    "SKIPPED": "Skipped",
    "DECLINED": "Declined",
    "NOT_APPLICABLE": "Not tracked"
  },
  "visits": [
    { "key": "birth",  "label": "Birth",        "anchorMonths": 0 },
    { "key": "m2",     "label": "2 month visit","anchorMonths": 2 },
    { "key": "m4",     "label": "4 month visit","anchorMonths": 4 },
    { "key": "m6",     "label": "6 month visit","anchorMonths": 6 },
    { "key": "m12",    "label": "12 month visit","anchorMonths": 12 },
    { "key": "m15",    "label": "15 month visit","anchorMonths": 15 },
    { "key": "m18",    "label": "18 month visit","anchorMonths": 18 },
    { "key": "y4_6",   "label": "4–6 year visit","anchorMonths": 48 },
    { "key": "annual", "label": "Seasonal",     "anchorMonths": 6 }
  ],
  "vaccines": {
    "HEPB": { "name": "Hepatitis B", "short": "HepB" },
    "RV":   { "name": "Rotavirus", "short": "RV", "note": "2-dose (RV1) or 3-dose (RV5) series depending on the product used" },
    "DTAP": { "name": "Diphtheria, tetanus, pertussis", "short": "DTaP" },
    "HIB":  { "name": "Haemophilus influenzae type b", "short": "Hib", "note": "3- or 4-dose primary series depending on the product used" },
    "PCV":  { "name": "Pneumococcal conjugate", "short": "PCV" },
    "IPV":  { "name": "Polio", "short": "IPV" },
    "MMR":  { "name": "Measles, mumps, rubella", "short": "MMR" },
    "VAR":  { "name": "Varicella (chickenpox)", "short": "Varicella" },
    "HEPA": { "name": "Hepatitis A", "short": "HepA" },
    "FLU":  { "name": "Influenza", "short": "Flu", "note": "Annual, from 6 months of age" },
    "COVID":{ "name": "COVID-19", "short": "COVID-19", "note": "Per current season; product and number of doses vary" },
    "RSV":  { "name": "RSV immunisation (nirsevimab)", "short": "RSV", "note": "Seasonal, for infants; some mothers are immunised in pregnancy instead" }
  },
  "doses": [
    { "id":"hepb_1", "vaccine":"HEPB", "dose":1, "visit":"birth", "fromMonths":0,  "toMonths":1,  "type":"routine", "note":"Usually within 24 hours of birth" },
