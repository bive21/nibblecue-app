    { "id":"hib_3",  "vaccine":"HIB",  "dose":3, "visit":"m6",    "fromMonths":6,  "toMonths":7,  "type":"conditional", "note":"4-dose product only" },
    { "id":"hib_4",  "vaccine":"HIB",  "dose":4, "visit":"m12",   "fromMonths":12, "toMonths":15, "type":"routine", "note":"Booster" },

    { "id":"pcv_1",  "vaccine":"PCV",  "dose":1, "visit":"m2",    "fromMonths":2,  "toMonths":3,  "type":"routine" },
    { "id":"pcv_2",  "vaccine":"PCV",  "dose":2, "visit":"m4",    "fromMonths":4,  "toMonths":5,  "type":"routine" },
    { "id":"pcv_3",  "vaccine":"PCV",  "dose":3, "visit":"m6",    "fromMonths":6,  "toMonths":7,  "type":"routine" },
    { "id":"pcv_4",  "vaccine":"PCV",  "dose":4, "visit":"m12",   "fromMonths":12, "toMonths":15, "type":"routine" },

    { "id":"ipv_1",  "vaccine":"IPV",  "dose":1, "visit":"m2",    "fromMonths":2,  "toMonths":3,  "type":"routine" },
    { "id":"ipv_2",  "vaccine":"IPV",  "dose":2, "visit":"m4",    "fromMonths":4,  "toMonths":5,  "type":"routine" },
    { "id":"ipv_3",  "vaccine":"IPV",  "dose":3, "visit":"m6",    "fromMonths":6,  "toMonths":18, "type":"routine" },
    { "id":"ipv_4",  "vaccine":"IPV",  "dose":4, "visit":"y4_6",  "fromMonths":48, "toMonths":72, "type":"routine" },

    { "id":"mmr_1",  "vaccine":"MMR",  "dose":1, "visit":"m12",   "fromMonths":12, "toMonths":15, "type":"routine" },
    { "id":"mmr_2",  "vaccine":"MMR",  "dose":2, "visit":"y4_6",  "fromMonths":48, "toMonths":72, "type":"routine" },

    { "id":"var_1",  "vaccine":"VAR",  "dose":1, "visit":"m12",   "fromMonths":12, "toMonths":15, "type":"routine" },
    { "id":"var_2",  "vaccine":"VAR",  "dose":2, "visit":"y4_6",  "fromMonths":48, "toMonths":72, "type":"routine" },

    { "id":"hepa_1", "vaccine":"HEPA", "dose":1, "visit":"m12",   "fromMonths":12, "toMonths":23, "type":"routine" },
    { "id":"hepa_2", "vaccine":"HEPA", "dose":2, "visit":"m18",   "fromMonths":18, "toMonths":29, "type":"routine", "note":"At least 6 months after dose 1" },

    { "id":"flu_annual",   "vaccine":"FLU",   "dose":null, "visit":"annual", "fromMonths":6, "toMonths":null, "type":"seasonal", "repeats":"annual", "defaultOn":false },
    { "id":"covid_season", "vaccine":"COVID", "dose":null, "visit":"annual", "fromMonths":6, "toMonths":null, "type":"seasonal", "repeats":"season", "defaultOn":false },
    { "id":"rsv_season",   "vaccine":"RSV",   "dose":null, "visit":"birth",  "fromMonths":0, "toMonths":8,    "type":"optional", "repeats":"season", "defaultOn":false, "note":"May not apply if the mother was immunised during pregnancy" }
  ],
  "statusRules": {
    "GIVEN": "a record exists with a given_date",
    "DUE": "no record and today >= window start (and window end is null or today <= window end)",
    "UPCOMING": "no record and today < window start",
    "PAST_WINDOW": "no record and window end is not null and today > window end — displayed neutrally, never as a warning",
    "nextVisit": "the earliest visit key whose doses are not all GIVEN/SKIPPED/DECLINED; its due date is the earliest window start among its unrecorded doses"
  },
  "reminders": {
    "grouping": "one reminder per visit, listing the doses it covers — never one per dose",
    "offsetsDays": [14, 2],
    "copyTemplate": "{{visitLabel}} is coming up — {{n}} doses in the published schedule. Check the plan with your pediatrician.",
    "deepLink": "{{URL_SCHEME}}://vaccines?child={{childId}}"
  }
}
