    { "id":"hepb_3", "vaccine":"HEPB", "dose":3, "visit":"m6",    "fromMonths":6,  "toMonths":18, "type":"routine" },

    { "id":"rv_1",   "vaccine":"RV",   "dose":1, "visit":"m2",    "fromMonths":2,  "toMonths":3.5,"type":"routine", "note":"Series is started before 15 weeks of age" },
    { "id":"rv_2",   "vaccine":"RV",   "dose":2, "visit":"m4",    "fromMonths":4,  "toMonths":5,  "type":"routine" },
    { "id":"rv_3",   "vaccine":"RV",   "dose":3, "visit":"m6",    "fromMonths":6,  "toMonths":8,  "type":"conditional", "note":"3-dose (RV5) product only" },

    { "id":"dtap_1", "vaccine":"DTAP", "dose":1, "visit":"m2",    "fromMonths":2,  "toMonths":3,  "type":"routine" },
    { "id":"dtap_2", "vaccine":"DTAP", "dose":2, "visit":"m4",    "fromMonths":4,  "toMonths":5,  "type":"routine" },
    { "id":"dtap_3", "vaccine":"DTAP", "dose":3, "visit":"m6",    "fromMonths":6,  "toMonths":7,  "type":"routine" },
