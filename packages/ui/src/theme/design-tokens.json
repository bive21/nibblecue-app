  "typography": {
    "families": {
      "ui": "Hanken Grotesk",
      "mono": "IBM Plex Mono"
    },
    "$note": "Numbers that line up — times, durations, volumes, a timer, a stat column — use the mono face with tabular figures. Every word, labels-in-caps and badges included (2026-09-26), uses the UI face.",
    "scale": {
      "display": {
        "size": 31,
        "weight": 600,
        "family": "mono",
        "tracking": -0.02,
        "use": "running timer elapsed"
      },
      "tabTitle": {
        "size": 28,
        "weight": 800,
        "family": "ui",
        "tracking": -0.025,
        "use": "a tab page's title: a page the tab bar reaches, with no back arrow (2026-09-30)"
      },
      "h1": {
        "size": 23,
        "weight": 800,
        "family": "ui",
        "tracking": -0.025,
        "use": "a pushed page's title: a page opened from another page, with a back arrow"
      },
      "h2": {
        "size": 18,
        "weight": 800,
        "family": "ui",
        "use": "sheet title"
      },
      "statValue": {
        "size": 22,
        "weight": 600,
        "family": "mono",
        "use": "stat tiles"
      },
      "bodyStrong": {
        "size": 15,
        "weight": 700,
        "family": "ui"
      },
      "body": {
        "size": 15,
        "weight": 400,
        "family": "ui",
        "lineHeight": 1.45
      },
      "bodySm": {
        "size": 13,
        "weight": 400,
        "family": "ui"
      },
      "meta": {
        "size": 12,
        "weight": 400,
        "family": "ui"
      },
      "label": {
        "size": 10,
        "weight": 700,
        "family": "ui",
        "tracking": 0.08,
        "transform": "uppercase",
        "use": "a small caps eyebrow — the UI face since 2026-09-26 (the owner: three faces in one section)"
      },
      "caption": {
        "size": 11.5,
        "weight": 700,
        "family": "ui",
        "tracking": 0.08,
        "transform": "uppercase",
        "use": "a section caption over a card — the UI face where `label`'s mono would read as machine-made"
      },
      "badge": {
        "size": 9.5,
        "weight": 700,
        "family": "ui",
        "tracking": 0.03,
        "transform": "uppercase"
      },
      "figureXl": {
        "size": 46,
        "weight": 700,
        "family": "ui",
        "tracking": -0.02,
        "use": "the one number a screen is about (the stash total)"
      },
      "figureLg": {
        "size": 30,
        "weight": 700,
        "family": "ui",
        "tracking": -0.015,
        "use": "a stat tile headline beside the figure it explains"
      }
    }
  },
