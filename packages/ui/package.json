{
  "name": "@nibblecue/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The design system: tokens, the three themes, six schemes and three skins, the appearance resolver, the icon set and the component inventory (docs/DESIGN_SYSTEM.md). React Native components that read tokens through useTheme(); no hex literal anywhere.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/theme.ts",
    "./moduleAccent": "./src/theme/moduleAccent.ts",
    "./appearance": "./src/theme/appearance.ts",
    "./layout": "./src/layout.ts",
    "./haptics": "./src/feedback/haptics.ts",
    "./skins": "./src/theme/skins.ts",
    "./contrast": "./src/theme/contrast.ts",
    "./glow": "./src/theme/glow.ts",
    "./artInk": "./src/theme/artInk.ts",
    "./placeTones": "./src/theme/placeTones.ts",
    "./ink": "./src/components/ink.ts",
    "./toast": "./src/components/toastQueue.ts",
    "./timePresets": "./src/components/timePresets.ts",
    "./timeFormat": "./src/components/timeFormat.ts",
    "./slotFit": "./src/components/slotFit.ts",
    "./design-tokens.json": "./src/theme/design-tokens.json",
    "./iconSvg": "./src/icons/svg.ts",
    "./iconPaths": "./src/icons/paths.ts",
    "./iconPathsCustom": "./src/icons/paths.custom.ts",
    "./illustrated": "./src/icons/illustrated.ts",
    "./illustratedAssets": "./src/icons/illustrated.assets.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nibblecue/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "~19.2.2",
    "expo-blur": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "expo-blur": "*",
    "expo-linear-gradient": "*",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*"
  }
}
