# dependencies
node_modules/
.pnpm-store/

# build output and caches
.turbo/
.next/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Expo (apps/mobile): ios/ and android/ are generated by `expo prebuild` and never edited
# by hand — every native change lives in a config plugin (docs/MOBILE.md §1).
.expo/
expo-env.d.ts
web-build/
apps/mobile/ios/
apps/mobile/android/
.metro-health-check*
.kotlin/

# environment: only .env.example is ever committed (CLAUDE.md §2.10)
.env
.env.*
!.env.example

# signing material never enters the repository (CLAUDE.md §2, identifiers)
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
npm-debug.*
yarn-debug.*
yarn-error.*

# pnpm only. `npm install` in a workspace root fails on `workspace:*` and a lockfile it
# leaves behind would resolve a second, conflicting tree.
package-lock.json
yarn.lock

# the gate writes its full output here; the last line is GATE_EXIT
gate.log
